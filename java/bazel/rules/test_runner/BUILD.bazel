load("//java:defs.bzl", "java_binary", "java_library")
load("//java/bazel/rules:jvm_test_info.bzl", "jvm_persistent_test_runner_info")

package(default_applicable_licenses = ["@rules_java//:license"])

java_binary(
    name = "persistent_test_runner",
    srcs = [
        "Config.java",
        "JvmPool.java",
        "JvmProcess.java",
        "PersistentTestRunner.java",
        "WrapperArgs.java",
    ],
    main_class = "com.google.devtools.build.java.testrunner.PersistentTestRunner",
    visibility = ["//visibility:public"],
    deps = ["//java/runfiles"],
)

java_library(
    name = "jvm_driver",
    srcs = ["JvmDriver.java"],
    visibility = ["//visibility:public"],
)

java_binary(
    name = "extension_scanner",
    srcs = ["ExtensionScanner.java"],
    main_class = "com.google.devtools.build.java.testrunner.ExtensionScanner",
    visibility = ["//visibility:public"],
)

java_binary(
    name = "extension_aggregator",
    srcs = ["ExtensionAggregator.java"],
    main_class = "com.google.devtools.build.java.testrunner.ExtensionAggregator",
    visibility = ["//visibility:public"],
)

jvm_persistent_test_runner_info(
    name = "jvm_persistent_test_runner_info",
    additional_deps = [":jvm_driver"],
    runner = ":persistent_test_runner",
    visibility = ["//visibility:public"],
)

toolchain(
    name = "persistent_test_runner_toolchain",
    toolchain = ":jvm_persistent_test_runner_info",
    toolchain_type = "//java/bazel/rules:jvm_test_toolchain_type",
    visibility = ["//visibility:public"],
)
