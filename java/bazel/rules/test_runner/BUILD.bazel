load("//java:defs.bzl", "java_binary", "java_library")
load("//java/bazel/rules:jvm_test_info.bzl", "jvm_persistent_test_runner_info")
load("@bazel_skylib//:bzl_library.bzl", "bzl_library")
load("@bazel_skylib//rules:common_settings.bzl", "bool_flag")
load("@rules_cc//cc:cc_binary.bzl", "cc_binary")

package(default_applicable_licenses = ["@rules_java//:license"])

bzl_library(
    name = "extensions_bzl",
    srcs = ["extensions.bzl"],
    visibility = ["//java/bazel/rules:__pkg__"],
    deps = ["//java/private:java_info_bzl"],
)

bzl_library(
    name = "persistent_test_info_bzl",
    srcs = ["persistent_test_info.bzl"],
    visibility = ["//java/bazel/rules:__pkg__"],
)

# Bazel's mock Java repository copies its Starlark sources from test runfiles.
# Include the package boundary as well as the provider loaded by java_binary.
filegroup(
    name = "for_bazel_tests",
    testonly = True,
    srcs = [
        "BUILD.bazel",
        ":extensions_bzl",
        ":persistent_test_info_bzl",
    ],
    visibility = ["//java/bazel/rules:__pkg__"],
)

java_binary(
    name = "persistent_test_runner",
    srcs = [
        "Config.java",
        "CoordinatorStore.java",
        "JvmPool.java",
        "JvmProcess.java",
        "PersistentTestRunner.java",
        "ReusableJvm.java",
        "TestEnvironment.java",
        "WrapperArgs.java",
    ],
    main_class = "com.google.devtools.build.java.testrunner.PersistentTestRunner",
    visibility = ["//visibility:public"],
    deps = [
        ":fifo_connection",
        "//java/bazel/rules/test_runner/persistent_worker:persistent_worker_lib",
        "//java/bazel/rules/test_runner/wire",
        "//java/runfiles",
    ],
)

java_library(
    name = "fifo_connection",
    srcs = ["FifoConnection.java"],
    visibility = ["//visibility:public"],
    deps = ["//java/bazel/rules/test_runner/wire"],
)

java_library(
    name = "jvm_driver",
    srcs = [
        "JvmDriver.java",
        "NativeTestContext.java",
        "ReusableCoverage.java",
        "ReusableTestDriver.java",
        "WarmClassLoader.java",
    ],
    resources = select({
        "@bazel_tools//src/conditions:linux": [":libtest_context.so"],
        "//conditions:default": [],
    }),
    resource_strip_prefix = "java/bazel/rules/test_runner",
    visibility = ["//visibility:public"],
    deps = [
        "//java/bazel/rules/test_runner/extension",
        "//java/bazel/rules/test_runner/wire",
    ],
)

cc_binary(
    name = "libtest_context.so",
    srcs = ["native_test_context.cc"],
    linkshared = True,
    target_compatible_with = ["@platforms//os:linux"],
    deps = ["//toolchains:jni"],
)

java_binary(
    name = "scan_jvm_test_runner_extensions",
    srcs = ["ScanJvmTestRunnerExtensions.java"],
    main_class = "com.google.devtools.build.java.testrunner.ScanJvmTestRunnerExtensions",
    visibility = ["//visibility:public"],
    deps = ["//java/bazel/rules/test_runner/persistent_worker:persistent_worker_lib"],
)

java_binary(
    name = "extension_aggregator",
    srcs = ["ExtensionAggregator.java"],
    main_class = "com.google.devtools.build.java.testrunner.ExtensionAggregator",
    visibility = ["//visibility:public"],
)

jvm_persistent_test_runner_info(
    name = "jvm_persistent_test_runner_info",
    additional_deps = [":jvm_driver"],
    runner = ":persistent_test_runner",
    visibility = ["//visibility:public"],
)

bool_flag(
    name = "enabled",
    build_setting_default = True,
    visibility = ["//visibility:public"],
)

config_setting(
    name = "enabled_setting",
    flag_values = {":enabled": "true"},
)

toolchain(
    name = "persistent_test_runner_toolchain",
    target_settings = [":enabled_setting"],
    toolchain = ":jvm_persistent_test_runner_info",
    toolchain_type = "//java/bazel/rules:jvm_test_toolchain_type",
    visibility = ["//visibility:public"],
)
