load("//java:defs.bzl", "java_test")

package(default_applicable_licenses = ["@rules_java//:license"])

java_test(
    name = "FifoConnectionTest",
    size = "small",
    timeout = "short",
    srcs = ["FifoConnectionTest.java"],
    main_class = "com.google.devtools.build.java.testrunner.FifoConnectionTest",
    target_compatible_with = ["@platforms//os:linux"],
    use_testrunner = False,
    deps = [
        "//java/bazel/rules/test_runner:fifo_connection",
        "//java/bazel/rules/test_runner/wire",
    ],
)

